# FeedX environment example / sync manifest
# ---------------------------------------------------------------------------
# Copy this to `.env` (loaded by python-dotenv) and fill in the values. This
# same file is the manifest for `feedx sync-secrets`: each name's trailing tag
# decides where it lands in GitHub Actions.
#
#   [secret] -> Actions "Secrets"   (encrypted, e.g. keys/tokens)
#   [var]    -> Actions "Variables" (plain, e.g. repo name, model)
# Untagged names (optional / workflow-local) are not synced.
# ===========================================================================

# --- Appwrite (required by ALL stages: init, crawl, content, feed) ----------
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1   # [secret]
APPWRITE_PROJECT_ID=                                       # [secret]
APPWRITE_API_KEY=                                          # [secret]
APPWRITE_DATABASE_ID=                                      # [secret]

# --- General ----------------------------------------------------------------
# "production" enables the 60s list_rows cache; "development" disables it.
ENVIRONMENT=production                                     # [var]
# Optional tag on a crawl/content run (bookkeeping only).
CRAWL_ID=                                                  # optional
# Max rows pulled when (re)building a queue from the DB (default 1000).
QUEUE_INIT_LIMIT=1000                                      # optional

# --- Crawl pipeline (crawl.yml) --------------------------------------------
# MUST be true on CI / headless runners; leave false locally to watch runs.
HEADLESS=true                                             # [var]
# How long before a source is eligible for re-discovery (default 21600 = 6h).
SOURCE_REFRESH_SECONDS=21600                              # [var]

# --- Content pipeline (content.yml) — LLM enrichment ------------------------
# content.yml runs Ollama on the runner via `docker compose up` (CPU-only), so
# OLLAMA_URL is the local endpoint and needs no secret. Keep OLLAMA_MODEL small
# (default llama3.2:1b) so the pull + inference fit the job timeout; a bigger
# model needs a self-hosted / GPU runner.
OLLAMA_URL=http://localhost:11434/v1                      # local (set in workflow)
# OLLAMA_BASE_URL is an accepted alias for OLLAMA_URL.
OLLAMA_MODEL=llama3.2:1b                                   # [var]
# Optional controlled tag vocabulary (comma/newline separated); empty = free-form.
CONTENT_TAGS=                                             # optional [var]

# --- Feed builder (feed.yml) ------------------------------------------------
# Ranking window and feed size.
FEED_WINDOW_DAY=30                                        # [var]
FEED_LIMIT=10                                             # [var]
# Publishing target = a SEPARATE content repo. FEED_TOKEN is a PAT with
# contents:write on that repo (the auto Actions token can't reach another repo).
# Names avoid the reserved GITHUB_ prefix, so they sync and are read verbatim
# everywhere — no renaming/mapping.
FEED_TOKEN=                                               # [secret]
FEED_REPO=owner/feed-content                              # [var]
FEED_BRANCH=main                                          # [var]
FEED_DIR=feeds                                            # [var]
# Override only for GitHub Enterprise (default https://api.github.com).
GITHUB_API_URL=https://api.github.com                     # optional

# --- Secrets sync (feedx sync-secrets) — LOCAL ONLY -------------------------
# Used only by the `feedx sync-secrets` command to push the values above into a
# repo's Actions secrets/variables over the REST API (token only, no `gh`). NOT
# read by any workflow, and NOT itself synced. The target is the RUNNER/code repo
# (where the workflows run), which may differ from FEED_REPO.
GITHUB_SYNC_REPO=owner/feedx                               # local only
# PAT with admin on that repo (Actions secrets + variables read/write).
GITHUB_SYNC_TOKEN=                                         # local only (admin PAT)
