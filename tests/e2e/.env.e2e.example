# Copy to tests/e2e/.env.e2e (gitignored) or export these before running the e2e suite.
# The e2e tests provision a throwaway Appwrite project via the Console SDK, so they
# need a CONSOLE user login — not a project API key. Point this at a self-hosted
# Appwrite instance you don't mind creating/deleting projects on.

# Console API endpoint (the same host you'd log into the Appwrite console on).
# Must be a local host - the suite refuses to bootstrap against anything else.
APPWRITE_CONSOLE_ENDPOINT=http://localhost/v1

# A console user. Created automatically if it doesn't exist; password must be >= 8 chars.
APPWRITE_CONSOLE_EMAIL=e2e@example.com
APPWRITE_CONSOLE_PASSWORD=supersecret8

# Set to "true" only if the instance uses a self-signed TLS certificate.
APPWRITE_CONSOLE_SELF_SIGNED=false

# Admin password + JWT secret the API itself checks during the test (any values).
E2E_ADMIN_PASSWORD=e2e-admin-pass
E2E_API_SECRET=e2e-secret-key

# Set to "true" to keep the provisioned project after the run (for debugging).
E2E_KEEP_PROJECT=false
